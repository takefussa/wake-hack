{
  "expo": {
    "name": "オキタ！",
    "slug": "wake-hack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wakehack",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ryosei.wakehack",
      "infoPlist": {
        "NSAlarmKitUsageDescription": "設定した時刻に、届いた声で朝を始めるためにアラームを使用します。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ryosei.wakehack"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#172033"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "明日の誰かに声を届けるため、マイクへのアクセスを許可してください。"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "プロフィール画像を選ぶため、写真へのアクセスを許可してください。",
          "cameraPermission": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
